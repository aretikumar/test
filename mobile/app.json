{
  "expo": {
    "name": "Amazon Job Monitor",
    "slug": "amazon-job-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0d0d14"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d14"
      },
      "package": "com.jobmonitor.amazon",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#ff9900"
        }
      ],
      "expo-background-fetch"
    ]
  }
}
